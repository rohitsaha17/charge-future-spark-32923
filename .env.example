# -------- Backend API --------
# Base URL of the self-hosted Express API, including the /api prefix.
# Read by src/lib/api.ts and scripts/generate-blog-sitemap.mjs, and used at
# build time by the `api-preconnect` plugin in vite.config.ts to emit the
# preconnect link and widen the CSP.
# Local development: http://localhost:4000/api
# Production:        https://api.apluscharge.in/api
VITE_API_URL="http://localhost:4000/api"

# -------- Google Maps (required for every map on the site) --------
# Both maps (the charging-station map on / and /find-charger, and the site
# location picker on /partner) render with the Google Maps JavaScript API.
# Create the key in the Google Cloud project that owns this site's Maps
# billing, enable "Maps JavaScript API", and restrict it by HTTP referrer.
# Without it the maps render a "Map unavailable" placeholder.
VITE_GOOGLE_MAPS_API_KEY=""

# Map ID for cloud-based map styling. Advanced markers (the custom charger
# pins) require one; leave blank to use Google's DEMO_MAP_ID, which works in
# development but should be replaced with a real Map ID for production.
# VITE_GOOGLE_MAPS_MAP_ID=""
