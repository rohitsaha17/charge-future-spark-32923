# -------- Backend API --------
# Base URL of the self-hosted Express API, including the /api prefix.
# Read by src/lib/api.ts and scripts/generate-blog-sitemap.mjs, and used at
# build time by the `api-preconnect` plugin in vite.config.ts to emit the
# preconnect link and widen the CSP.
# Local development: http://localhost:4000/api
# Production:        https://api.apluscharge.in/api
VITE_API_URL="http://localhost:4000/api"

# -------- Optional: Google Maps --------
# Leave blank to use the bundled MapLibre + Esri tile stack (default).
# VITE_GOOGLE_MAPS_API_KEY=""
