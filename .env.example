# -------- Custom REST API (the primary backend as of Aug 2026) --------
# All data and auth flow through this host. The Supabase client in this
# codebase is now a shim that translates Supabase-style calls into
# fetch() calls against these endpoints. See BACKEND-SPEC.md.
VITE_API_BASE_URL="https://api.apluscharge.in"

# -------- Legacy Supabase vars (kept for backwards compatibility) --------
# These are read by scripts/generate-blog-sitemap.mjs only. Leave blank
# unless you also have a Supabase mirror to sync from.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# -------- Optional: Google Maps --------
# Leave blank to use the bundled MapLibre + Esri tile stack (default).
# VITE_GOOGLE_MAPS_API_KEY=""
